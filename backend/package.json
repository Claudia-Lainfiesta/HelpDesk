{
  "name": "helpdesk-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.23.1" },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:up": "tsx src/db/up.ts",
    "db:down": "podman compose down",
    "db:logs": "podman compose logs -f postgres",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:status": "tsx src/db/cli.ts status",
    "db:new": "tsx src/db/cli.ts new",
    "db:reset": "tsx src/db/cli.ts reset",
    "db:seed:dev": "tsx src/db/cli.ts seed",
    "test:db": "tsx --test test/db-tools.test.ts",
    "test:server": "tsx --test test/server.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2"
  }
}
