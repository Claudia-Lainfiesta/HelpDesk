# APP: desarrollo usa Angular 4200 + API 3000. En Render: NODE_ENV=production.
NODE_ENV=development
# Render proporciona PORT automáticamente; no es necesario definirlo allí.
PORT=3000
# Producción: origen HTTPS real de la única Web Service, sin ruta ni barra final.
FRONTEND_ORIGIN=http://localhost:4200
# Render: 1 salto de proxy; local: false. Nunca true para confiar en todos.
TRUST_PROXY=false

# DATABASE: única conexión usada por la API y herramientas; sin Supabase SDK/Auth.
# Codifica los caracteres especiales de usuario/contraseña en la URI.
# Supabase: pega la URI de Session Pooler únicamente en tu entorno privado.
# Producción aplica sslmode=verify-full; require se eleva a verificación completa.
# Si requiere una CA: añade &sslrootcert=/ruta/absoluta/al/certificado.crt.
# En Render usa un Secret File para la CA y su ruta bajo /etc/secrets/.
DATABASE_URL=postgresql://<usuario>:<contrasena>@localhost:5432/<nombre_de_la_base_de_datos>
# Solo Compose local: la aplicación NO exige POSTGRES_* en Render.
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk_local_dev
POSTGRES_DB=helpdesk
# Solo desarrollo: vacío usa contraseña aleatoria privada en .seed-dev-password.
# Nunca ejecutar el seed de desarrollo contra Supabase/producción.
SEED_DEV_PASSWORD=

# SESSION Y LOGIN: mismos valores predeterminados en local y producción.
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Solicitudes de login por IP en una ventana de 15 minutos.
LOGIN_RATE_LIMIT_PER_IP=30
# Cuentas temporales: días desde su creación, no duración de la contraseña temporal.
TEMP_ACCOUNT_DEFAULT_DAYS=7
TEMP_ACCOUNT_MAX_DAYS=30

# SMTP: valores locales de Mailpit; en producción configura el proveedor real.
# Brevo/Render Free: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=2525,
# SMTP_SECURE=false y SMTP_REQUIRE_TLS=true (STARTTLS obligatorio).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
# Login SMTP y clave SMTP del proveedor, no contraseña de correo ni API key REST.
SMTP_USER=
SMTP_PASSWORD=
# Remitente verificado y destinatario administrativo: definirlos en Render.
# No incrustar direcciones reales del proyecto ni secretos en este archivo.
MAIL_FROM=helpdesk@example.invalid
RECOVERY_ADMIN_EMAIL=admin@example.invalid
# Recuperación: ventanas de 15 minutos por IP y 60 minutos por correo normalizado.
RECOVERY_RATE_LIMIT_PER_IP=10
RECOVERY_RATE_LIMIT_PER_EMAIL=3

# TELEGRAM: opcional; los avisos de grupo requieren ambas variables.
# No intervienen en el deep-link directo al agente (username almacenado en DB).
TELEGRAM_BOT_TOKEN=
# ID negativo de un grupo/supergrupo, no username ni chat privado.
TELEGRAM_SUPPORT_CHAT_ID=
