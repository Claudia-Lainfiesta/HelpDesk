PORT=3000
FRONTEND_ORIGIN=http://localhost:4200
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk_local_dev
POSTGRES_DB=helpdesk
# Sustituye los marcadores con los valores anteriores. Codifica caracteres especiales de la URL.
DATABASE_URL=postgresql://<usuario>:<contrasena>@localhost:5432/<nombre_de_la_base_de_datos>
# Opcionales para la API; el token solo se exige al ejecutar el bot.
TELEGRAM_BOT_TOKEN=
# IDs numéricos separados por comas; vacío permite a cualquier usuario.
TELEGRAM_ALLOWED_USER_IDS=
# Sesiones y bloqueo de autenticación.
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Solicitudes de login por IP en una ventana de 15 minutos.
LOGIN_RATE_LIMIT_PER_IP=30
# false o número de saltos confiables (0 a 10); nunca true para confiar en todos.
TRUST_PROXY=false
# Solo desarrollo: vacío usa una clave aleatoria local en .seed-dev-password.
SEED_DEV_PASSWORD=
